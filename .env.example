# Mail relay (Reg.ru hosting — VPS cannot use HTTPS/DNS to etagere.online)
MAIL_RELAY_URL=http://31.31.198.123/etagere-mail.php
MAIL_RELAY_HOST=etagere.online
MAIL_RELAY_SECRET=etagere-mail-relay-2026
NEXT_PUBLIC_APP_URL=https://etagere.ru

# PocketBase (browser)
NEXT_PUBLIC_POCKETBASE_URL=https://api.etagere.ru
# Server-side on VPS — public HTTPS may not loop back; use localhost
POCKETBASE_INTERNAL_URL=http://127.0.0.1:8090
POCKETBASE_ADMIN_EMAIL=admin@etagere.local
POCKETBASE_ADMIN_PASSWORD=changeme123

# SMTP (newsletter + optional; PocketBase auth mail uses Admin → Settings → Mail)
SMTP_HOST=mail.hosting.reg.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@etagere.ru
SMTP_PASS=
SMTP_FROM="Étagère <noreply@etagere.ru>"

# Google Drive OAuth (optional)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Required: without it Drive cannot keep a connection past one hour.
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_API_KEY=
NEXT_PUBLIC_GOOGLE_APP_ID=1069484265184
# Public support contact (footer, email footers)
NEXT_PUBLIC_SUPPORT_EMAIL=hello@etagere.ru

# VK ID (id.vk.ru) — App ID + protected key from https://id.vk.com/
# Trusted redirect: https://etagere.ru/api/auth/vk/callback
NEXT_PUBLIC_VK_CLIENT_ID=
VK_CLIENT_SECRET=

# Yandex ID — https://oauth.yandex.ru/
# Login redirect: https://etagere.ru/api/auth/yandex/callback
# Disk redirect (same app): https://etagere.ru/api/cloud/yandex/callback
# Disk scope: cloud_api:disk.appfolder
NEXT_PUBLIC_YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# Dropbox — https://www.dropbox.com/developers/apps
# Redirect: https://etagere.ru/api/cloud/dropbox/callback
# Permission: App folder
NEXT_PUBLIC_DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=

# OneDrive (Microsoft Graph) — https://portal.azure.com/ → App registrations
# Redirect: https://etagere.ru/api/cloud/onedrive/callback
# Permissions: Files.ReadWrite.AppFolder, offline_access
NEXT_PUBLIC_ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=

# Telegram Login Widget — token from @BotFather; /setdomain → etagere.ru
TELEGRAM_BOT_TOKEN=

# GigaChat (Sber) — translate + chat. Authorization key from developers.sber.ru
GIGACHAT_AUTH_KEY=
# GIGACHAT_SCOPE=GIGACHAT_API_PERS
# GIGACHAT_MODEL=GigaChat-2-Max
# GIGACHAT_MODEL=GigaChat-3-Ultra
# GIGACHAT_MODEL=GigaChat-2-Pro
# GIGACHAT_MODEL=GigaChat-2

# Monthly AI chat caps (messages per calendar month). Dictionary lookup is unlimited.
# AI_LIMIT_CHAT_FREE=40
# AI_LIMIT_CHAT_PRO=200

# Piper local TTS (preferred). Binary + voices on the VPS.
# PIPER_BIN=/opt/etagere/piper/piper
# PIPER_VOICES_DIR=/opt/etagere/piper/voices
# PIPER_ESPEAK_DATA=/opt/etagere/piper/espeak-ng-data

# ElevenLabs — optional cloud fallback
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_MODEL=eleven_multilingual_v2

# YooKassa — 100 ₽/мес Pro. Shop ID + secret from https://yookassa.ru/my
# Webhook: https://etagere.ru/api/billing/yookassa/webhook
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Random string for daily renew cron (scripts/yookassa-renew.sh)
YOOKASSA_RENEW_SECRET=
# Receipt for 54-FZ. Set 1 after the shop has a cash register / YooKassa receipts.
# YOOKASSA_RECEIPT=1
# YOOKASSA_VAT_CODE=1
# Dev only: allow the paid stub button
# BILLING_ALLOW_STUB=1
